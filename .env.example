# Server environment only. Never prefix these with NEXT_PUBLIC_ or VITE_.
APP_ORIGIN=http://127.0.0.1:8765
APP_ENV=development
APP_TIMEZONE=America/New_York
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Your immutable numeric GitHub user ID, not your login name.
GITHUB_OWNER_ID=
# Fine-grained, expiring, selected repositories, read-only Contents/Issues/PRs.
GITHUB_READ_TOKEN=
GITHUB_REPOSITORIES=Yousseft2002/Project-Dashboard
# Production: absolute path on a private durable disk.
# TRACKER_DATA_DIR=
AI_SUMMARIES_ENABLED=false
# Optional, explicitly sends commit messages and file counts to OpenAI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
